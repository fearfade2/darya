# Configure these in the Vercel project's server-side environment.
# Primary backend: HTTPS origin only, without credentials, path, query, or fragment.
ALISA_PRIMARY_BACKEND_URL=
# Optional fallback: https://<tunnel-name>.trycloudflare.com, without a trailing slash.
# deploy/tunnel.py updates this value when fallback deployment is configured.
ALISA_BACKEND_URL=
# At least one valid backend must be configured; otherwise the proxy returns 503.
