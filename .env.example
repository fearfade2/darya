HOST=127.0.0.1
PORT=8790
COOKIE_SECURE=false
PUBLIC_ORIGINS=http://127.0.0.1:8790
TELEGRAM_PORT=5222
DATA_DIR=data
# Optionally supply a model-provider Secret in the service environment:
# ALISA_AI_KEY=
# ALISA_AI_KEY_HOST=api.xpiki.com
# HERMES_API_URL=http://127.0.0.1:8642
# Optional HTTPS fallback deployment (requires an existing production Vercel deployment):
# ALISA_VERCEL_TOKEN=
# ALISA_VERCEL_PROJECT_ID=
# ALISA_VERCEL_TEAM_ID=
# ALISA_VERCEL_ALIASES=
# Team ID is optional for personal projects; aliases are comma-separated hostnames.
